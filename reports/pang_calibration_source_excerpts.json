    {
      "path": "imaging-analysis/computeDFF.m",
      "sha256": "86d09a60bf84c706798721025249bc7ef6815d84411155467e57ad328296257b",
      "url": "https://github.com/ClandininLab/L1L2-recurrent-feedback/blob/7fa5829e37d566e02beaaa87efd6a0f1de4e48c0/imaging-analysis/computeDFF.m",
      "numbered_source": [
        "1: % computeDFF.m",
        "2: %",
        "3: % Function that takes in background-subtracted fluorescence signal over",
        "4: %  time, performs bleaching correction (sum of two exponentials), and",
        "5: %  returns dF/F. ",
        "6: % For bleaching correction, fits sum of two exponentials to portion of",
        "7: %  fluorescence curve taken as input and uses it as F0 in dF/F = (F-F0)/F0",
        "8: %  calculation. Which portion of fluorescence curve is used for fitting",
        "9: %  effectively defines where dF/F=0 sits.",
        "10: %",
        "11: % INPUT",
        "12: %   bksSignal - background-subtracted fluorescence signal over time, for",
        "13: %       single ROI",
        "14: %   imgFrameTimes - times at which bksSignal values were captured",
        "15: %   baselineSignal - background-subtracted fluorescence signal over time,",
        "16: %       for same ROI, but can be subset of bksSignal. Used for fitting",
        "17: %       during bleaching correction.",
        "18: %   baselineTimes - times at which baselineSignal values were captured",
        "19: %",
        "20: % OUTPUT",
        "21: %   dFF - bleaching corrected dF/F trace for single ROI; as vector",
        "22: %",
        "23: function dFF = computeDFF(bksSignal, imgFrameTimes, baselineSignal, ...",
        "24:     baselineTimes)    ",
        "25: ",
        "26:     % make column vectors if needed",
        "27:     if isrow(bksSignal)",
        "28:         bksSignal = bksSignal';",
        "29:     end ",
        "30:     if isrow(baselineSignal)",
        "31:         baselineSignal = baselineSignal';",
        "32:     end",
        "33:     ",
        "34:     if isrow(baselineTimes) %MMP 230210 added",
        "35:         baselineTimes = baselineTimes';",
        "36:     end",
        "37:     ",
        "38:     try",
        "39:         fitobj = fit(baselineTimes, baselineSignal, fittype('exp2'));",
        "40:     catch err ",
        "41:         if(strcmp(err.identifier,'curvefit:fit:nanComputed') ||...",
        "42:             strcmp(err.identifier,'curvefit:fit:xDataMustBeColumnVector'))",
        "43:         else",
        "44:             rethrow(err);",
        "45:         end",
        "46:     end ",
        "47:     ",
        "48:     baselineF = fitobj(imgFrameTimes);",
        "49:     dFF = bksSignal./baselineF - 1;  % equivalent to (F - F0)/F0",
        "50:     ",
        "51:     clear fitobj",
        "52: ",
        "53: end "
      ]
    },
    {
      "path": "imaging-analysis/HHY_stimulusSpecificAnalysisScripts/shortFlashProcessed_saveMean.m",
      "sha256": "e5c9daf537b4a3f20c7708e3b1c6ccac66b37f3e1cba943a1ffa4c6c6c447cb7",
      "url": "https://github.com/ClandininLab/L1L2-recurrent-feedback/blob/7fa5829e37d566e02beaaa87efd6a0f1de4e48c0/imaging-analysis/HHY_stimulusSpecificAnalysisScripts/shortFlashProcessed_saveMean.m",
      "numbered_source": [
        "1: % shortFlashProcessed_saveMean.m",
        "2: %",
        "3: % Script to load processed short flash data and to save just the mean",
        "4: %  response for the light flash and the dark flash.",
        "5: % Only for data format for L1/L2 paper.",
        "6: % To send data to Shaul regarding request by email on 3/8/18.",
        "7: % Updated to save individual responses as well as the mean.",
        "8: %",
        "9: % Updated: 3/14/18",
        "10: ",
        "11: % where to save new .mat files",
        "12: saveDir = '/Users/hyang/Documents/New Imaging Analysis/AnalyzedData/ImpulseResponsesForShaul/';",
        "13: ",
        "14: % which stimulus flashes",
        "15: pairedEpochs = [1 2];",
        "16: ",
        "17: fileDir = '/Users/hyang/Documents/New Imaging Analysis/AnalyzedData/CurrentAnalyzedData';",
        "18: cd(fileDir)",
        "19: ",
        "20: % loop through every file in folder",
        "21: fileList = dir('*.mat');",
        "22: ",
        "23: for i = 1:length(fileList)",
        "24:     ",
        "25:     % get short flash data file",
        "26:     fileName = fileList(i).name;",
        "27:     ",
        "28:     % load data file - only roiDataMat and iResp variables needed",
        "29:     load(fileName, 'roiDataMat', 'iResp');",
        "30:     % short flash stimulus, responding cells only",
        "31:     respROIMat = roiDataMat(iResp, 2);",
        "32:     ",
        "33:     % preallocate",
        "34:     numResp = size(pairedEpochs, 2); % total number impulse responses",
        "35:     meanResp = zeros(numResp,length(respROIMat(1).rats{pairedEpochs(1)}));",
        "36:         ",
        "37:     for j = 1:size(pairedEpochs, 2) % number of contrast values",
        "38:         % preallocate",
        "39:         rats = zeros(length(respROIMat),...",
        "40:             length(respROIMat(1).rats{pairedEpochs(j)}));",
        "41: ",
        "42:         % get all individual ROI responses",
        "43:         for n = 1:length(respROIMat)",
        "44:             rats(n,:) = respROIMat(n).rats{pairedEpochs(j)};",
        "45:         end ",
        "46:         % mean response",
        "47:         meanResp(j,:) = mean(rats,1);",
        "48:         % individual responses",
        "49:         indivResp{j} = rats;",
        "50:     end",
        "51:     ",
        "52:     % time",
        "53:     t = respROIMat(1).t{1};",
        "54:     ",
        "55:     % save data file",
        "56:     save([saveDir fileName], 'meanResp','indivResp','t');",
        "57: end",
        "58:     "
      ]
    },
    {
      "path": "imaging-analysis/analyze_FullFieldFlashOntoGray.m",
      "sha256": "faf71824c5d539e7e80beb59400f44ea89a7817d5d386165a7cc38c65b5b019e",
      "url": "https://github.com/ClandininLab/L1L2-recurrent-feedback/blob/7fa5829e37d566e02beaaa87efd6a0f1de4e48c0/imaging-analysis/analyze_FullFieldFlashOntoGray.m",
      "numbered_source": [
        "1: % analyze_FullFieldFlashOntoGray.m",
        "2: %",
        "3: % Script to analyze Full Field Flash Onto Gray stimulus. Converts",
        "4: %  output of selectTimeSeries.m to mean stimulus-locked response for each",
        "5: %  ROI and generates some plots. Saves this analyzed data.",
        "6: % Run immediately after selectTimeSeries.m without clearing the workspace",
        "7: %  variables.",
        "8: % Works on single time series per ROI where the Full Field Flash Onto Gray",
        "9: %  was presented or on multiple time series per ROI where the reference",
        "10: %  stimulus was FullFieldFlash_BinaryContrast or SearchStimulusFlash and",
        "11: %  the non-reference stimuli are all FullFieldFlashOntoGray.",
        "12: % ",
        "13: % Updated: 3/24/17 - HHY",
        "14: %",
        "15: ",
        "16: %% (1) Get mean stimulus-locked response for each ROI, select responding ROIs",
        "17: if size(roiDataMat,2) == 1 % if only one column exists",
        "18:     [roiDataMat, iResp, iInv, framesPerLDCycle] = ...",
        "19:         filterROIs_stimLockedPlots_FFFoG_noRef(roiDataMat,pairedEpochs,...",
        "20:         interpFrameRate, inv, yScale, binWidthMult);",
        "21: else % if there's more than one column",
        "22:     [roiDataMat, iResp, iInv, framesPerLDCycle] = ...",
        "23:         filterROIs_stimLockedPlots_FFFoG(roiDataMat, refColumn, ...",
        "24:         pairedEpochs, interpFrameRate, inv, yScale, binWidthMult);",
        "25: end ",
        "26: ",
        "27: respROIMat = roiDataMat(iResp,:);",
        "28: ",
        "29: %% (2) plot responses averaged over ROIs",
        "30: if size(roiDataMat,2) ~= 1",
        "31:     % plot reference stimulus",
        "32:     fffDuration = roiDataMat(1,1).stimDat.Duration{1}; ",
        "33:     % only responding cells",
        "34:     plot_FullFieldFlash(respROIMat(:,1), inv, yScale, ...",
        "35:         1/interpFrameRate, fffDuration, refPlotTitle, 1);",
        "36:     refFig = gcf;",
        "37:     % all cells",
        "38:     plot_FullFieldFlash(roiDataMat(:,1), inv, yScale, ...",
        "39:         1/interpFrameRate, fffDuration, refPlotTitle, 1);",
        "40: end ",
        "41: ",
        "42: % plot non-reference stimulus",
        "43: nrefColumn = 2; % which column of data to plot",
        "44: % all cells",
        "45: plot_FFFOntoGray(roiDataMat(:,nrefColumn), inv, yScale, nrefPlotTitle, ...",
        "46:     pairedEpochs);",
        "47: % only responding cells",
        "48: plot_FFFOntoGray(respROIMat(:,nrefColumn), inv, yScale, nrefPlotTitle, ...",
        "49:     pairedEpochs);",
        "50: nrefFig = gcf;",
        "51: ",
        "52: %% (3) Save Data",
        "53: save([savePath filesep saveName], 'roiDataMat', 'roiMetaMat', 'iResp', ...",
        "54:     'iInv','binWidthMult','interpFrameRate','inv','yScale', '-v7.3');",
        "55: % save figures",
        "56: if size(roiDataMat,2) ~= 1",
        "57:     saveas(refFig,[figPath filesep saveName '_ref'],'fig');",
        "58: end ",
        "59: saveas(nrefFig,[figPath filesep saveName '_fffgFig'],'fig');"
      ]
    }
  ]
}
